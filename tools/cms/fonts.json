{
 "_about": "The website editor's Fonts page (/admin/#/fonts). Each group sets one CSS variable family used across the site (assets/site.css :root). A choice is saved as a change with scope '@fonts' and o 'font:<group id>'; tools/cms/cms.py writes assets/cms-fonts.css from it. 'spec' is the Google Fonts css2 axis list for that family (checked to load).",
 "groups": [
  {"id": "headings", "name": "Headings and big numbers", "hint": "Page titles, section headings, product names and the large figures.", "default": "League Spartan", "sample": "Navigating with Excellence", "upper": true,
   "vars": ["--display"]},
  {"id": "text", "name": "Text, menu and buttons", "hint": "Paragraphs, the menu, buttons, tables, forms and the footer.", "default": "Montserrat", "sample": "Elemental sulphur in granular, prilled and lump form, produced to international standards.",
   "vars": ["--sans", "--mono", "--hdr-sans"]},
  {"id": "charts", "name": "Chart numbers", "hint": "The numbers and labels on the market price charts.", "default": "Barlow", "sample": "USD 182.50 / t  +2.4%",
   "vars": ["--chart"]},
  {"id": "typewriter", "name": "Typewriter labels", "hint": "The small typewriter style labels on the Commodities page, such as View product.", "default": "Courier Prime", "sample": "View product", "mono": true,
   "vars": ["--type"]}
 ],
